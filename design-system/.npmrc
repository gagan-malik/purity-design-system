registry=https://registry.npmjs.org/

# GitHub Packages registry for this design system.
# Do NOT commit tokens. Use an environment variable instead:
# - **Local**: export NPM_TOKEN=... (classic PAT with `read:packages`, and `write:packages` if publishing)
# - **CI**: store as a secret named `NPM_TOKEN`
@purity:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
